Signal
[ energy:[ Provider Name Threshold Reminder Minutes Percent ResetId Target Span Override Baseline ] ] ; imports Energy Nexus vocabulary
[ Call.{ Caller Input.[ Configure.Set ] } ]                 ; carries the peer caller and meta input
[ Configured.Set                                            ; meta outputs
  ConfigureRefused.String ]
[ Caller.{ ProcessId.Integer UserId.Integer }               ; local envelope and configuration types
  Set.[ Threshold.Threshold                                 ; one configurable value per variant
        Reminder.Reminder
        RemoveReminder.Reminder
        RedeemExpiring.Minutes
        RedeemUsedAtLeast.Percent
        Target.{ Provider Target }                          ; one provider target
        WindowTarget.{ Provider Name Target }               ; one window override
        Program.{ Program.[ Codex Flow ] Path.String }      ; one configured external program
        Credentials.Path
        Span                                                ; one span of the schedule, added
        RemoveSpan.Span
        Override                                            ; one stretch of time, set over the schedule
        RemoveOverride.Override
        Baseline ] ]                                        ; the usefulness of every hour no span names
