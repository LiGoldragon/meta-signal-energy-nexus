Signal
[ signal_energy_nexus:[ Caller Threshold Reminder Minutes Percent ProviderTarget Span Override Baseline TimeZone Credit Spent ] ] ; imports the Energy vocabulary and the ordinary envelope
[ Configure.Set ]                                           ; the meta input
[ Configured.Set                                            ; meta outputs
  ConfigureRefused ]                                        ; any setting's refusal
[ Call.{ Caller Input }                                     ; carries the peer caller and the meta input
  ConfigureRefused.[ TargetExceedsWeek.ProviderTarget       ; a target of more hours than the provider's Week window lasts
                     RuleRefused.String ]                   ; any other rule a setting breaks, in words
  Set.[ Threshold.Threshold                                 ; one configurable value per variant
        Reminder.Reminder
        RemoveReminder.Reminder
        RedeemExpiring.Minutes
        RedeemUsedAtLeast.Percent
        Target.ProviderTarget                               ; one provider target, a SpendBy counted in hours before the window resets, for Week, FableWeek and its configured Credit period
        Program.{ Program.[ Codex Flow ] Path.String }      ; one configured external program
        Credentials.Path
        Span                                                ; one span of the schedule, added
        RemoveSpan.Span
        Override                                            ; one stretch of time, set over the schedule
        RemoveOverride.Override
        Baseline                                            ; the usefulness of every hour no span names
        TimeZone
        Credit                                                ; one configured grant and its expiry lead time
        Spent ] ]                                             ; one observed amount spent during the configured period
